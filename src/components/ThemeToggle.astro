---
---

<button
	type="button"
	id="theme-toggle"
	aria-label="テーマを切り替える"
	title="テーマを切り替える"
	class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-card bg-theme-toggle-bg text-text-primary shadow-sm backdrop-blur-md transition hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-theme-toggle-ring"
>
	<svg
		data-icon="sun"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="h-5 w-5"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="5"></circle>
		<line x1="12" y1="1" x2="12" y2="3"></line>
		<line x1="12" y1="21" x2="12" y2="23"></line>
		<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
		<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
		<line x1="1" y1="12" x2="3" y2="12"></line>
		<line x1="21" y1="12" x2="23" y2="12"></line>
		<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
		<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
	</svg>
	<svg
		data-icon="moon"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="h-5 w-5"
		aria-hidden="true"
	>
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
</button>

<script>
	import {
		THEME_STORAGE_KEY,
		type ResolvedTheme,
		applyResolvedTheme,
		getCurrentResolvedTheme,
		getStoredMode,
		resolveTheme,
		watchSystemScheme,
	} from "@/lib/theme";

	const button = document.getElementById("theme-toggle");

	const LABELS: Record<ResolvedTheme, string> = {
		dark: "ライトモードに切り替える",
		light: "ダークモードに切り替える",
	};

	const syncLabel = (resolvedTheme: ResolvedTheme) => {
		const label = LABELS[resolvedTheme];
		button?.setAttribute("aria-label", label);
		button?.setAttribute("title", label);
	};

	const setResolvedTheme = (resolvedTheme: ResolvedTheme) => {
		applyResolvedTheme(resolvedTheme);
		syncLabel(resolvedTheme);
	};

	syncLabel(getCurrentResolvedTheme());

	button?.addEventListener("click", () => {
		const next: ResolvedTheme = getCurrentResolvedTheme() === "dark" ? "light" : "dark";
		localStorage.setItem(THEME_STORAGE_KEY, next);
		setResolvedTheme(next);
	});

	watchSystemScheme((prefersDark) => {
		if (getStoredMode() !== "system") return;
		setResolvedTheme(resolveTheme("system", prefersDark));
	});
</script>
