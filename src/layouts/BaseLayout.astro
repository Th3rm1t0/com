---
import { SITE_TITLE } from "@/consts";
import "@/styles/global.css";

type Props = {
	title?: string;
};

const { title = SITE_TITLE } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			as="style"
			fetchpriority="high"
		/>
		<link
			id="font-inter"
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			media="print"
		/>
		<link
			rel="preload"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap"
			as="style"
			fetchpriority="high"
		/>
		<link
			id="font-noto-sans-jp"
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap"
			media="print"
		/>
		<script is:inline>
			(function () {
				var key = "theme-mode";
				var storedMode = localStorage.getItem(key);
				var mode =
					storedMode === "light" || storedMode === "dark" || storedMode === "system"
						? storedMode
						: "system";
				var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				var resolvedTheme = mode === "system" ? (prefersDark ? "dark" : "light") : mode;

				document.documentElement.setAttribute("data-theme", resolvedTheme);
				document.documentElement.style.colorScheme = resolvedTheme;
			})();

			// media="print" defers these off the critical path; swap in once loaded.
			for (var id of ["font-inter", "font-noto-sans-jp"]) {
				var link = document.getElementById(id);
				if (link) {
					link.addEventListener("load", function () {
						this.media = "all";
					});
				}
			}
		</script>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
